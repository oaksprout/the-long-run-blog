# ===========================================
# Jinn Blog Environment Configuration
# ===========================================

# Site URL (Railway will auto-generate this)
NEXT_PUBLIC_SITE_URL=https://your-blog.up.railway.app

# ===========================================
# Umami Analytics (Required for learning loop)
# ===========================================
# These are set after deploying Umami on Railway

# Website ID from Umami dashboard (Settings > Websites)
NEXT_UMAMI_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Umami script URL (your Railway Umami instance)
NEXT_UMAMI_SRC=https://your-umami.up.railway.app/script.js

# ===========================================
# Agent Configuration (for external agent use)
# ===========================================
# API key for agent to query analytics
UMAMI_API_KEY=umami_api_xxxxxxxxxxxxxx
UMAMI_HOST=https://your-umami.up.railway.app
UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
